# GESTURA AI - Environment Configuration Example
# Copy to .env for custom configuration

# Backend Host & Port
GESTURA_HOST=127.0.0.1
GESTURA_PORT=8000
GESTURA_DEBUG=false

# Kinematics & Computer Control Defaults
GESTURA_SENSITIVITY=1.35
GESTURA_CURSOR_SPEED=1.25
GESTURA_CLICK_DELAY=0.35
GESTURA_SCROLL_SPEED=1.0
GESTURA_SMOOTHING_FACTOR=0.28
GESTURA_LEFT_HANDED_MODE=false

# Safe Failsafes
GESTURA_FAILSAFE_PINCH_MAX_MS=3000
GESTURA_EMERGENCY_FIST_LOCK=true

# Database Path
GESTURA_DB_PATH=./backend/gestura.db
